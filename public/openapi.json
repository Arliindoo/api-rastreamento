    "/contestacoes/{id}": {
      "patch": {
        "operationId": "decidirContestacao",
        "summary": "Decidir contestação aberta",
        "description": "HU5 · RN10. Suporte registra uma única decisão e a justificativa.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Decisão persistida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contestacao"
                },
                "examples": {
                  "resposta": {
                    "value": {
                      "id": 1,
                      "encomendaId": "ENC-001",
                      "estado": "Decidida",
                      "abertaEm": "2026-11-20T17:00:00Z",
                      "motivo": "Pacote entregue a outra pessoa.",
                      "decisao": "Contestação acolhida",
                      "justificativa": "Suporte confirmou entrega a terceiro.",
                      "responsavel": "suporte",
                      "decididaEm": "2026-11-20T18:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Decisão ou justificativa inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": "Dados inválidos."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 401,
                      "error": "Unauthorized",
                      "message": "Credenciais inválidas."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil ou vínculo sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 403,
                      "error": "Forbidden",
                      "message": "Perfil sem permissão para esta operação."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 404,
                      "error": "Not Found",
                      "message": "Recurso indisponível."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Contestação já decidida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 409,
                      "error": "Conflict",
                      "message": "Conflito com o registro existente."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decidir"
              },
              "examples": {
