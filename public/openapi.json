          "tipo": {
            "type": "string",
            "enum": [
              "SAIDA"
            ]
          },
          "ocorridoEm": {
            "type": "string",
            "format": "date-time",
            "description": "Instante ISO 8601 com fuso, segundos obrigatórios e até três casas de milissegundos. A resposta usa UTC."
