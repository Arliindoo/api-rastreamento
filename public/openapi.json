{
  "openapi": "3.0.3",
  "info": {
    "title": "09A · Rastreamento de encomendas",
    "version": "1.0.0",
    "description": "Contrato das cinco operações do formulário da dupla."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "security": [
    {
      "contaLocal": []
    }
  ],
  "paths": {
    "/encomendas/{id}/eventos": {
      "post": {
        "operationId": "registrarEvento",
        "summary": "Registrar evento ou reconhecer reenvio",
        "description": "HU1 e HU2 · RN1–RN7. Expedição registra coleta, operador usa seu centro, motorista atua na encomenda atribuída. Reenvios são comparados com o evento normalizado e o responsável.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "ENC-001"
          }
        ],
        "responses": {
          "201": {
            "description": "Evento persistido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recibo"
                },
                "examples": {
                  "resposta": {
                    "value": {
                      "id": "evt-1",
                      "tipo": "COLETA",
                      "ocorridoEm": "2026-11-20T12:00:00.000Z",
                      "recebidoEm": "2026-11-20T12:01:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Evento ou prova já recebido. Retorna o recibo original.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recibo"
                },
                "examples": {
                  "resposta": {
                    "value": {
                      "id": "evt-1",
                      "tipo": "COLETA",
                      "ocorridoEm": "2026-11-20T12:00:00.000Z",
                      "recebidoEm": "2026-11-20T12:01:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Campos inválidos ou centro inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": "Dados inválidos."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 401,
                      "error": "Unauthorized",
                      "message": "Credenciais inválidas."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil ou vínculo sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 403,
                      "error": "Forbidden",
                      "message": "Perfil sem permissão para esta operação."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 404,
                      "error": "Not Found",
                      "message": "Recurso indisponível."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "ID de evento ou comprovante com dados divergentes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 409,
                      "error": "Conflict",
                      "message": "Conflito com o registro existente."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventoEntrada"
              },
              "examples": {
                "coleta": {
                  "value": {
                    "id": "evt-1",
                    "tipo": "COLETA",
                    "ocorridoEm": "2026-11-20T09:00:00-03:00",
                    "origem": "Expedição central"
                  }
                },
                "entrada": {
                  "value": {
                    "id": "evt-2",
                    "tipo": "ENTRADA",
                    "ocorridoEm": "2026-11-20T09:00:00-03:00",
                    "centroId": "CD-01"
                  }
                },
                "saida": {
                  "value": {
                    "id": "evt-3",
                    "tipo": "SAIDA",
                    "ocorridoEm": "2026-11-20T09:00:00-03:00",
                    "centroId": "CD-01"
                  }
                },
                "tentativa": {
                  "value": {
                    "id": "evt-4",
                    "tipo": "TENTATIVA",
                    "ocorridoEm": "2026-11-20T09:00:00-03:00",
                    "resultado": "Não concluída",
                    "motivo": "Destinatário ausente"
                  }
                },
                "entrega": {
                  "value": {
                    "id": "evt-5",
                    "tipo": "ENTREGA",
                    "ocorridoEm": "2026-11-20T09:00:00-03:00",
                    "comprovante": {
                      "id": "cp-1",
                      "conteudo": "Recebido na portaria."
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Eventos"
        ]
      },
      "get": {
        "operationId": "investigar",
        "summary": "Investigar eventos e contestações",
        "description": "HU5 · RN7 e RN10. Suporte consulta os horários, responsáveis e provas vinculadas. Ordem por fato e sequência de gravação.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "ENC-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Histórico interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Investigacao"
                },
                "examples": {
                  "resposta": {
                    "value": {
                      "encomendaId": "ENC-001",
                      "eventos": [
                        {
                          "id": "evt-1",
                          "tipo": "COLETA",
                          "ocorridoEm": "2026-11-20T12:00:00.000Z",
                          "recebidoEm": "2026-11-20T12:01:00.000Z",
                          "responsavel": "expedicao",
                          "origem": "Expedição central",
                          "centroId": null,
                          "resultado": null,
                          "motivo": null,
                          "comprovanteId": null,
                          "comprovanteConteudo": null
                        }
                      ],
                      "contestacoes": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 401,
                      "error": "Unauthorized",
                      "message": "Credenciais inválidas."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil ou vínculo sem permissão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 403,
                      "error": "Forbidden",
                      "message": "Perfil sem permissão para esta operação."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "falha": {
                    "value": {
                      "statusCode": 404,
                      "error": "Not Found",
                      "message": "Recurso indisponível."
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Eventos"
        ]
      }
    },
    "/encomendas/{id}/rastreamento": {
      "get": {
        "operationId": "rastrear",
        "summary": "Consultar rastreamento próprio",
        "description": "HU3 · RN5 e RN8. Cliente vinculado. Histórico crescente pelo horário do fato. As decisões do suporte aparecem nas contestações.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "ENC-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos resumidos e contestações da encomenda.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rastreamento"
                },
                "examples": {
                  "resposta": {
                    "value": {
                      "encomendaId": "ENC-001",
                      "status": "Coletada",
                      "eventos": [
                        {
                          "tipo": "COLETA",
                          "ocorridoEm": "2026-11-20T12:00:00.000Z"
                        }
                      ],
                      "contestacoes": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas.",
