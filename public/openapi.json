  "components": {
    "securitySchemes": {
      "contaLocal": {
        "type": "http",
        "scheme": "basic",
        "description": "Contas locais de demonstração descritas no README."
      }
    },
    "schemas": {
      "Comprovante": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "conteudo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "conteudo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "Coleta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
